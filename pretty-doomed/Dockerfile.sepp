# PRETTY DOOMed build environment for OPS-SAT SEPP (ARM32)
#
# Uses pre-built GNU Radio + gr-iio + libad9361 libraries from
# sandbox/gnuradio/build-libs-armv7/output/ (mounted via docker-compose).
# No GNU Radio compilation needed, significantly faster build.
#
# PREREQUISITES:
#   1. Setup QEMU emulation:
#      docker run --rm --privileged tonistiigi/binfmt --install arm
#
#   2. Import exp_env:
#      docker import --platform linux/arm/v7 resources/exp_env.tar.gz exp_env:latest
#
#   3. Pre-built GNU Radio ARM32 libs must exist at:
#      sandbox/gnuradio/build-libs-armv7/output/
#      (see sandbox/gnuradio/build-libs-armv7/README.md)

FROM exp_env:latest

RUN echo "https://dl-cdn.alpinelinux.org/alpine/edge/testing" >> /etc/apk/repositories \
    && apk update && apk add --no-cache \
    build-base \
    cmake \
    git \
    pkgconf \
    boost-dev \
    fftw-dev \
    spdlog-dev \
    fmt-dev \
    libsndfile-dev \
    gmp-dev \
    libvolk-dev \
    libiio-dev \
    upx

# glibc compatibility stubs for musl
# The pre-built onnxruntime library requires glibc symbols not in musl
RUN printf '%s\n' \
    '#include <sys/stat.h>' \
    'char __libc_single_threaded = 0;' \
    'int backtrace(void **buffer, int size) { (void)buffer; (void)size; return 0; }' \
    'char **backtrace_symbols(void *const *buffer, int size) { (void)buffer; (void)size; return (char **)0; }' \
    'void backtrace_symbols_fd(void *const *buffer, int size, int fd) { (void)buffer; (void)size; (void)fd; }' \
    'int stat64(const char *path, struct stat *buf) { return stat(path, buf); }' \
    'int fstat64(int fd, struct stat *buf) { return fstat(fd, buf); }' \
    'int lstat64(const char *path, struct stat *buf) { return lstat(path, buf); }' \
    > /tmp/glibc_compat.c && \
    gcc -c /tmp/glibc_compat.c -o /usr/lib/glibc_compat.o && \
    gcc -shared -o /usr/lib/libglibc_compat.so /usr/lib/glibc_compat.o && \
    rm /tmp/glibc_compat.c

# Create glibc dynamic linker symlink so libonnxruntime.so can be loaded on musl
RUN ln -sf /lib/ld-musl-armhf.so.1 /lib/ld-linux-armhf.so.3

# Pre-built GNU Radio libs are mounted at /app/libs-gnuradio via docker-compose.
# Set up the paths so pkg-config and the linker find them.
ENV LD_LIBRARY_PATH="/app/libs-gnuradio:${LD_LIBRARY_PATH}"

WORKDIR /app

CMD ["/bin/sh"]
