#!/bin/sh
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export LD_LIBRARY_PATH="${SCRIPT_DIR}/libs:${LD_LIBRARY_PATH}"

# Locate binaries: check SEPP layout first, then Docker dev layout
if [ -x "${SCRIPT_DIR}/pretty-doomed" ]; then
    PRETTY_DOOMED="${SCRIPT_DIR}/pretty-doomed"
elif [ -x "${SCRIPT_DIR}/build/local/pretty-doomed" ]; then
    PRETTY_DOOMED="${SCRIPT_DIR}/build/local/pretty-doomed"
else
    echo "Error: pretty-doomed binary not found" >&2
    exit 1
fi

if [ -x "${SCRIPT_DIR}/opssat-doom" ]; then
    DOOM_BINARY="${SCRIPT_DIR}/opssat-doom"
elif [ -x "${SCRIPT_DIR}/doom-build/local/opssat-doom" ]; then
    DOOM_BINARY="${SCRIPT_DIR}/doom-build/local/opssat-doom"
else
    echo "Error: opssat-doom binary not found" >&2
    exit 1
fi

TOGROUND="${SCRIPT_DIR}/toGround"
CONFIG="${SCRIPT_DIR}/config.cfg"
VARIANTS="${SCRIPT_DIR}/variants.cfg"
DEMOS="${SCRIPT_DIR}/demos"

mkdir -p "$TOGROUND"

# --- Helper: next run ID ---
next_run_id() {
    LAST_RUN=0
    for d in "$TOGROUND"/run-[0-9][0-9][0-9][0-9][0-9]; do
        [ -d "$d" ] || continue
        n=${d##*-}
        n=$(echo "$n" | sed 's/^0*//')
        [ -z "$n" ] && n=0
        [ "$n" -gt "$LAST_RUN" ] && LAST_RUN=$n
    done
    echo $((LAST_RUN + 1))
}

# --- Phase 1: File input (georges_01.wav) ---
WAV_FILE="${SCRIPT_DIR}/input/georges_01.wav"
if [ -f "$WAV_FILE" ]; then
    RUNID=$(next_run_id)
    RUN_DIR=$(printf "%s/run-%05d" "$TOGROUND" "$RUNID")
    mkdir -p "$RUN_DIR"
    echo "Run $(printf '%05d' "$RUNID"): georges_01.wav (file input)"
    ${PRETTY_DOOMED} \
        -i "$WAV_FILE" \
        -c "$CONFIG" \
        -f "$VARIANTS" \
        -o "$RUN_DIR" \
        -d "$DEMOS" \
        -e "${DOOM_BINARY}"
fi

# --- Phase 2: SDR capture, sequential mode (2 x 20s) ---
RUNID=$(next_run_id)
RUN_DIR=$(printf "%s/run-%05d" "$TOGROUND" "$RUNID")
mkdir -p "$RUN_DIR"
echo "Run $(printf '%05d' "$RUNID"): SDR capture (sequential, 2x20s)"

# Create config with overrides
cp -f "$CONFIG" "$RUN_DIR/config.cfg"
cat >> "$RUN_DIR/config.cfg" <<EOF

# Run overrides
sdr_captures=2
process_mode=sequential
EOF

${PRETTY_DOOMED} \
    -s \
    -c "$RUN_DIR/config.cfg" \
    -f "$VARIANTS" \
    -o "$RUN_DIR" \
    -d "$DEMOS" \
    -e "${DOOM_BINARY}"

# --- Phase 3: SDR capture, background mode (2 x 20s) ---
RUNID=$(next_run_id)
RUN_DIR=$(printf "%s/run-%05d" "$TOGROUND" "$RUNID")
mkdir -p "$RUN_DIR"
echo "Run $(printf '%05d' "$RUNID"): SDR capture (background, 2x20s)"

cp -f "$CONFIG" "$RUN_DIR/config.cfg"
cat >> "$RUN_DIR/config.cfg" <<EOF

# Run overrides
sdr_captures=2
process_mode=background
EOF

${PRETTY_DOOMED} \
    -s \
    -c "$RUN_DIR/config.cfg" \
    -f "$VARIANTS" \
    -o "$RUN_DIR" \
    -d "$DEMOS" \
    -e "${DOOM_BINARY}"
