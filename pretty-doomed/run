#!/bin/sh
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export LD_LIBRARY_PATH="${SCRIPT_DIR}/libs:${LD_LIBRARY_PATH}"

# Locate binaries: check SEPP layout first, then Docker dev layout
if [ -x "${SCRIPT_DIR}/pretty-doomed" ]; then
    PRETTY_DOOMED="${SCRIPT_DIR}/pretty-doomed"
elif [ -x "${SCRIPT_DIR}/build/local/pretty-doomed" ]; then
    PRETTY_DOOMED="${SCRIPT_DIR}/build/local/pretty-doomed"
else
    echo "Error: pretty-doomed binary not found" >&2
    exit 1
fi

if [ -x "${SCRIPT_DIR}/opssat-doom" ]; then
    DOOM_BINARY="${SCRIPT_DIR}/opssat-doom"
elif [ -x "${SCRIPT_DIR}/doom-build/local/opssat-doom" ]; then
    DOOM_BINARY="${SCRIPT_DIR}/doom-build/local/opssat-doom"
else
    echo "Error: opssat-doom binary not found" >&2
    exit 1
fi

TOGROUND="${SCRIPT_DIR}/toGround"
CONFIG="${SCRIPT_DIR}/config.cfg"
VARIANTS="${SCRIPT_DIR}/variants.cfg"
DEMOS="${SCRIPT_DIR}/demos"

mkdir -p "$TOGROUND"

# --- Helper: next run ID ---
next_run_id() {
    LAST_RUN=0
    for d in "$TOGROUND"/run-[0-9][0-9][0-9][0-9][0-9]; do
        [ -d "$d" ] || continue
        n=${d##*-}
        n=$(echo "$n" | sed 's/^0*//')
        [ -z "$n" ] && n=0
        [ "$n" -gt "$LAST_RUN" ] && LAST_RUN=$n
    done
    echo $((LAST_RUN + 1))
}

# --- Phase 1: File input mode (two test files) ---
# georges_01.wav: contains "PRETTY PLAY DOOM" (expects command detection)
# oli_10.wav: does NOT contain DOOM command (expects no detection)
INPUT_DIR="${SCRIPT_DIR}/input"
for WAV_NAME in georges_01.wav oli_10.wav; do
    WAV_FILE="${INPUT_DIR}/${WAV_NAME}"
    if [ ! -f "$WAV_FILE" ]; then
        echo "Warning: $WAV_FILE not found, skipping"
        continue
    fi

    RUNID=$(next_run_id)
    RUN_DIR=$(printf "%s/run-%05d" "$TOGROUND" "$RUNID")
    mkdir -p "$RUN_DIR"

    echo "Run $(printf '%05d' "$RUNID"): ${WAV_NAME} (file input)"

    ${PRETTY_DOOMED} \
        -i "$WAV_FILE" \
        -c "$CONFIG" \
        -f "$VARIANTS" \
        -o "$RUN_DIR" \
        -d "$DEMOS" \
        -e "${DOOM_BINARY}" \
        > "$RUN_DIR/pretty-doomed.log" 2>&1
done

# --- Phase 2: SDR capture mode (3 x 20-second captures) ---
SDR_CAPTURES=3
CAPTURE_NUM=0
while [ "$CAPTURE_NUM" -lt "$SDR_CAPTURES" ]; do
    CAPTURE_NUM=$((CAPTURE_NUM + 1))
    RUNID=$(next_run_id)
    RUN_DIR=$(printf "%s/run-%05d" "$TOGROUND" "$RUNID")
    mkdir -p "$RUN_DIR"

    echo "Run $(printf '%05d' "$RUNID"): SDR capture ${CAPTURE_NUM}/${SDR_CAPTURES}"

    ${PRETTY_DOOMED} \
        -s \
        -c "$CONFIG" \
        -f "$VARIANTS" \
        -o "$RUN_DIR" \
        -d "$DEMOS" \
        -e "${DOOM_BINARY}" \
        > "$RUN_DIR/pretty-doomed.log" 2>&1

    STATUS=$?
    if [ "$STATUS" -ne 0 ] && [ "$CAPTURE_NUM" -lt "$SDR_CAPTURES" ]; then
        echo "  Capture ${CAPTURE_NUM} failed (status=$STATUS), waiting 5s..."
        sleep 5
    fi
done
