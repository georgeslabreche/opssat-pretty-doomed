#!/bin/sh
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export LD_LIBRARY_PATH="${SCRIPT_DIR}/libs:${LD_LIBRARY_PATH}"

# Locate binaries: check SEPP layout first, then Docker dev layout
if [ -x "${SCRIPT_DIR}/pretty-doomed" ]; then
    PRETTY_DOOMED="${SCRIPT_DIR}/pretty-doomed"
elif [ -x "${SCRIPT_DIR}/build/local/pretty-doomed" ]; then
    PRETTY_DOOMED="${SCRIPT_DIR}/build/local/pretty-doomed"
else
    echo "Error: pretty-doomed binary not found" >&2
    exit 1
fi

if [ -x "${SCRIPT_DIR}/opssat-doom" ]; then
    DOOM_BINARY="${SCRIPT_DIR}/opssat-doom"
elif [ -x "${SCRIPT_DIR}/doom-build/local/opssat-doom" ]; then
    DOOM_BINARY="${SCRIPT_DIR}/doom-build/local/opssat-doom"
else
    echo "Error: opssat-doom binary not found" >&2
    exit 1
fi

# Input: file or directory (default: all WAVs in input/)
INPUT="${1:-${SCRIPT_DIR}/input}"

# Collect WAV files to process
if [ -d "$INPUT" ]; then
    WAV_FILES=$(find "$INPUT" -maxdepth 1 -name '*.wav' | sort)
    if [ -z "$WAV_FILES" ]; then
        echo "Error: no .wav files found in $INPUT" >&2
        exit 1
    fi
else
    WAV_FILES="$INPUT"
fi

TOGROUND="${SCRIPT_DIR}/toGround"
mkdir -p "$TOGROUND"

for WAV_FILE in $WAV_FILES; do
    LAST=$(ls -d "$TOGROUND"/run-* 2>/dev/null | sort -V | tail -1 | grep -o '[0-9]\{5\}$')
    LAST_STRIPPED=$(echo "${LAST:-0}" | sed 's/^0*//' )
    RUNID=$((${LAST_STRIPPED:-0} + 1))
    RUN_DIR=$(printf "%s/run-%05d" "$TOGROUND" "$RUNID")
    mkdir -p "$RUN_DIR"

    echo "Run $(printf '%05d' "$RUNID"): $(basename "$WAV_FILE")"

    ${PRETTY_DOOMED} \
        -i "$WAV_FILE" \
        -c "${SCRIPT_DIR}/config.cfg" \
        -f "${SCRIPT_DIR}/variants.cfg" \
        -o "$RUN_DIR" \
        -d "${SCRIPT_DIR}/demos" \
        -e "${DOOM_BINARY}" \
        > "$RUN_DIR/pretty-doomed.log" 2>&1
done
