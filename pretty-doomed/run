#!/bin/sh
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export LD_LIBRARY_PATH="${SCRIPT_DIR}/libs:${LD_LIBRARY_PATH}"

# Locate binaries: check SEPP layout first, then Docker dev layout
if [ -x "${SCRIPT_DIR}/pretty-doomed" ]; then
    PRETTY_DOOMED="${SCRIPT_DIR}/pretty-doomed"
elif [ -x "${SCRIPT_DIR}/build/local/pretty-doomed" ]; then
    PRETTY_DOOMED="${SCRIPT_DIR}/build/local/pretty-doomed"
else
    echo "Error: pretty-doomed binary not found" >&2
    exit 1
fi

if [ -x "${SCRIPT_DIR}/opssat-doom" ]; then
    DOOM_BINARY="${SCRIPT_DIR}/opssat-doom"
elif [ -x "${SCRIPT_DIR}/doom-build/local/opssat-doom" ]; then
    DOOM_BINARY="${SCRIPT_DIR}/doom-build/local/opssat-doom"
else
    echo "Error: opssat-doom binary not found" >&2
    exit 1
fi

TOGROUND="${SCRIPT_DIR}/toGround"
CONFIG="${PRETTY_CONFIG:-${SCRIPT_DIR}/config.cfg}"
VARIANTS="${SCRIPT_DIR}/variants.cfg"
DEMOS="${SCRIPT_DIR}/demos"

mkdir -p "$TOGROUND"

# --- Resource monitor: per-core CPU + memory to CSV every second ---
start_monitor() {
    _DIR="$1"
    _TIMEOUT="${2:-3600}"
    _PARENT=$$
    echo "epoch,timestamp,cpu0_user,cpu0_nice,cpu0_system,cpu0_idle,cpu0_iowait,cpu1_user,cpu1_nice,cpu1_system,cpu1_idle,cpu1_iowait,mem_total_kb,mem_available_kb,mem_free_kb" > "$_DIR/resource.csv"
    {
        _ELAPSED=0
        while [ $_ELAPSED -lt $_TIMEOUT ]; do
            # Exit if parent process died (orphan guard)
            kill -0 $_PARENT 2>/dev/null || break
            _EPOCH=$(date '+%s')
            _TS=$(date '+%Y-%m-%d %H:%M:%S')
            _CPU0=$(awk '/^cpu0/ {print $2","$3","$4","$5","$6}' /proc/stat)
            _CPU1=$(awk '/^cpu1/ {print $2","$3","$4","$5","$6}' /proc/stat)
            _MEM=$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} /MemFree/{f=$2} END{print t","a","f}' /proc/meminfo)
            echo "$_EPOCH,$_TS,$_CPU0,$_CPU1,$_MEM"
            sleep 1
            _ELAPSED=$((_ELAPSED + 1))
        done
    } >> "$_DIR/resource.csv" 0<&- &
    echo $!
}

stop_monitor() {
    kill "$1" 2>/dev/null
    wait "$1" 2>/dev/null
}

# --- Helper: next run ID ---
next_run_id() {
    LAST_RUN=0
    for d in "$TOGROUND"/run-[0-9][0-9][0-9][0-9][0-9]; do
        [ -d "$d" ] || continue
        n=${d##*-}
        n=$(echo "$n" | sed 's/^0*//')
        [ -z "$n" ] && n=0
        [ "$n" -gt "$LAST_RUN" ] && LAST_RUN=$n
    done
    echo $((LAST_RUN + 1))
}

# --- Helper: create per-run config with overrides ---
# Copies base config.cfg into the run directory and appends overrides.
# This avoids modifying the original config.cfg (which may be read-only
# on the SEPP after extraction from the deployment tarball).
make_run_config() {
    _RUN_DIR="$1"
    shift
    cp -f "$CONFIG" "$_RUN_DIR/config.cfg"
    for _OVERRIDE in "$@"; do
        echo "$_OVERRIDE" >> "$_RUN_DIR/config.cfg"
    done
}

# --- Single run: all settings from config.cfg ---
RUNID=$(next_run_id)
RUN_DIR=$(printf "%s/run-%05d" "$TOGROUND" "$RUNID")
mkdir -p "$RUN_DIR"

make_run_config "$RUN_DIR"

echo "Run $(printf '%05d' "$RUNID")"
MON_PID=$(start_monitor "$RUN_DIR" 3600)

${PRETTY_DOOMED} \
    -s \
    -c "$RUN_DIR/config.cfg" \
    -f "$VARIANTS" \
    -o "$RUN_DIR" \
    -d "$DEMOS" \
    -e "${DOOM_BINARY}"

stop_monitor "$MON_PID"
