#!/bin/sh

# OPSSAT PRETTY SDR Capture - OPS-SAT SEPP Entrypoint
#
# Runs N sequential RF captures (N = captures in config.cfg).
# Each capture produces FM-demodulated audio and sc16 I/Q data from AD9361 SDR.
#
# Usage: ./run [--duration N] [--captures N]
#   --duration N  Override capture duration per capture in seconds
#   --captures N  Override number of captures (default from config.cfg)
#
# Directory structure:
#   toGround/run-NNNNNN/                    - One directory per execution
#   toGround/run-NNNNNN/capture-NNN/         - One subdirectory per capture
#   toGround/run-NNNNNN/capture-NNN/capture.wav
#   toGround/run-NNNNNN/capture-NNN/capture.sc16
#   toGround/run-NNNNNN/capture-NNN/capture.log

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

CONFIG_FILE="${SCRIPT_DIR}/config.cfg"

# Preflight checks
[ -x "${SCRIPT_DIR}/capture_loop" ] || { echo "Error: capture_loop not found or not executable" >&2; exit 1; }
[ -f "$CONFIG_FILE" ] || { echo "Error: missing $CONFIG_FILE" >&2; exit 1; }

# Set up library path to find bundled shared libraries
if [ -n "$LD_LIBRARY_PATH" ]; then
    export LD_LIBRARY_PATH="${SCRIPT_DIR}/libs:$LD_LIBRARY_PATH"
else
    export LD_LIBRARY_PATH="${SCRIPT_DIR}/libs"
fi

# Read captures from config file (default: 1 if not set or unparseable)
CAPTURES=$(grep -E '^captures=' "$CONFIG_FILE" | tail -1 | cut -d= -f2 | tr -d ' \t\r')
case "$CAPTURES" in
    ''|*[!0-9]*)
        CAPTURES=1
        ;;
    *)
        [ "$CAPTURES" -gt 0 ] || CAPTURES=1
        ;;
esac

# Parse arguments (command-line overrides config)
DURATION=""
while [ $# -gt 0 ]; do
    case "$1" in
        --duration)
            [ -n "$2" ] || { echo "Error: --duration requires a value" >&2; exit 1; }
            DURATION="$2"
            shift 2
            ;;
        --captures)
            [ -n "$2" ] || { echo "Error: --captures requires a value" >&2; exit 1; }
            CAPTURES="$2"
            shift 2
            ;;
        *)
            echo "Error: unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

# Validate captures
case "$CAPTURES" in
    ''|*[!0-9]*)
        echo "Error: captures must be a positive integer, got '$CAPTURES'" >&2
        exit 1
        ;;
    *)
        [ "$CAPTURES" -gt 0 ] || { echo "Error: captures must be > 0" >&2; exit 1; }
        ;;
esac

# Validate duration override if provided
if [ -n "$DURATION" ]; then
    case "$DURATION" in
        ''|*[!0-9]*)
            echo "Error: duration must be a positive integer, got '$DURATION'" >&2
            exit 1
            ;;
        *)
            [ "$DURATION" -gt 0 ] || { echo "Error: duration must be > 0" >&2; exit 1; }
            ;;
    esac
fi

TOGROUND_DIR="${SCRIPT_DIR}/toGround"
mkdir -p "$TOGROUND_DIR"

# Auto-increment run ID (one run directory per execution)
# Uses shell glob with strict pattern to avoid ls parsing and sort -V portability issues
LAST_RUN=0
for d in "$TOGROUND_DIR"/run-[0-9][0-9][0-9][0-9][0-9][0-9]; do
    [ -d "$d" ] || continue
    n=${d##*-}
    # Strip leading zeros for arithmetic (POSIX sh treats 08/09 as invalid octal)
    n=$(echo "$n" | sed 's/^0*//' )
    [ -z "$n" ] && n=0
    [ "$n" -gt "$LAST_RUN" ] && LAST_RUN=$n
done
RUNID=$((LAST_RUN + 1))

RUN_DIR=$(printf "%s/run-%06d" "$TOGROUND_DIR" "$RUNID")
mkdir -p "$RUN_DIR"

RUN_LOG="${RUN_DIR}/run.log"

# Redirect all subsequent stderr to run.log so unexpected errors are captured
exec 2>> "$RUN_LOG"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Run $RUNID: Starting capture session ($CAPTURES captures)" >> "$RUN_LOG"

# Track failures across captures
CAPTURE_NUM=0
FAILURES=0

# Main capture loop (bounded by CAPTURES)
while [ "$CAPTURE_NUM" -lt "$CAPTURES" ]; do
    CAPTURE_NUM=$((CAPTURE_NUM + 1))
    CAPTURE_DIR=$(printf "%s/capture-%03d" "$RUN_DIR" "$CAPTURE_NUM")
    mkdir -p "$CAPTURE_DIR"

    LOG_FILE="${CAPTURE_DIR}/capture.log"
    OUTPUT_FILE="${CAPTURE_DIR}/capture.wav"

    # Log start
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting RF Capture #${CAPTURE_NUM}/${CAPTURES}" > "$LOG_FILE"
    echo "Run ID: $RUNID" >> "$LOG_FILE"
    echo "Output: $OUTPUT_FILE" >> "$LOG_FILE"

    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Capture #${CAPTURE_NUM}/${CAPTURES}: Capturing..." >> "$RUN_LOG"

    # Run capture with config file; duration from config.cfg unless overridden
    if [ -n "$DURATION" ]; then
        "${SCRIPT_DIR}/capture_loop" \
            --config "$CONFIG_FILE" \
            --output "$OUTPUT_FILE" \
            --duration "$DURATION" \
            >> "$LOG_FILE" 2>&1
    else
        "${SCRIPT_DIR}/capture_loop" \
            --config "$CONFIG_FILE" \
            --output "$OUTPUT_FILE" \
            >> "$LOG_FILE" 2>&1
    fi

    STATUS=$?
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Capture completed with status: $STATUS" >> "$LOG_FILE"

    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Capture #${CAPTURE_NUM}/${CAPTURES}: Complete (status=$STATUS)" >> "$RUN_LOG"

    [ "$STATUS" -eq 0 ] || FAILURES=$((FAILURES + 1))

    # After a failure, pause before next capture to give the IIO server time
    # to detect the dead TCP connection and free the connection slot.
    # On local IIO (real hardware) this is harmless; on network IIO (emulator)
    # a crashed capture leaves a stale TCP connection that blocks new ones.
    if [ "$STATUS" -ne 0 ] && [ "$CAPTURE_NUM" -lt "$CAPTURES" ]; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Waiting 5s for IIO cleanup after failure (status=$STATUS)..." >> "$RUN_LOG"
        sleep 5
    fi
done

# Read frequency from config for summary
FREQ=$(grep -E '^frequency=' "$CONFIG_FILE" | tail -1 | cut -d= -f2 | tr -d ' \t\r')
[ -n "$FREQ" ] || FREQ="(unknown)"

# Create summary for the entire run
{
    echo "OPSSAT PRETTY SDR Capture Results"
    echo "==================="
    echo "Run ID: $RUNID"
    echo "Captures: $CAPTURE_NUM"
    echo "Failures: $FAILURES"
    echo "Frequency: $FREQ Hz"
    echo ""
    echo "Output files:"
    ls -la "$RUN_DIR"/capture-*/capture.* 2>/dev/null || echo "  (none)"
} > "${RUN_DIR}/summary.txt"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Run $RUNID complete ($CAPTURE_NUM captures, $FAILURES failed)." >> "$RUN_LOG"
exit $( [ "$FAILURES" -gt 0 ] && echo 1 || echo 0 )
