#!/bin/sh

# SDR Loopback Test - OPS-SAT SEPP Entrypoint
#
# Validates AD9361 TX->RX chain using internal loopback mode.
# Processes WAV files through FM modulation/demodulation.
#
# Directory structure:
#   input/          - Input WAV files (packaged)
#   io/input/       - Input WAV files (development)
#   toGround/       - Output artifacts for downlink

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Set up library path to find bundled shared libraries
export LD_LIBRARY_PATH="${SCRIPT_DIR}/libs:${LD_LIBRARY_PATH}"

# I/O directories - check for packaged structure first, then dev structure
if [ -d "${SCRIPT_DIR}/input" ]; then
    INPUT_DIR="${SCRIPT_DIR}/input"
else
    INPUT_DIR="${SCRIPT_DIR}/io/input"
fi
TOGROUND_DIR="${SCRIPT_DIR}/toGround"

# Create toGround directory if it doesn't exist
mkdir -p "$TOGROUND_DIR"

# Auto-increment run ID based on existing runs
LAST_RUN=$(ls -d "$TOGROUND_DIR"/run-* 2>/dev/null | sort -V | tail -1 | grep -o '[0-9]\{6\}$')
if [ -z "$LAST_RUN" ]; then
    RUNID=1
else
    RUNID=$((10#$LAST_RUN + 1))
fi

RUN_DIR=$(printf "%s/run-%06d" "$TOGROUND_DIR" "$RUNID")

# Create run directory
mkdir -p "$RUN_DIR"

# Log file
LOG_FILE="${RUN_DIR}/loopback.log"

# Log start
echo "$(date '+%Y-%m-%d %H:%M:%S') - Starting SDR Loopback Test" > "$LOG_FILE"
echo "Run ID: $RUNID" >> "$LOG_FILE"
echo "Input directory: $INPUT_DIR" >> "$LOG_FILE"
echo "Output directory: $RUN_DIR" >> "$LOG_FILE"

# Process all WAV files in input directory
PROCESSED=0
for INPUT_FILE in "$INPUT_DIR"/*.wav; do
    if [ -f "$INPUT_FILE" ]; then
        FILENAME=$(basename "$INPUT_FILE")
        OUTPUT_FILE="${RUN_DIR}/captured_${FILENAME}"

        echo "$(date '+%Y-%m-%d %H:%M:%S') - Processing: $FILENAME" >> "$LOG_FILE"

        "${SCRIPT_DIR}/loopback_test" \
            --input "$INPUT_FILE" \
            --output "$OUTPUT_FILE" \
            >> "$LOG_FILE" 2>&1

        STATUS=$?
        echo "$(date '+%Y-%m-%d %H:%M:%S') - Completed $FILENAME with status: $STATUS" >> "$LOG_FILE"

        PROCESSED=$((PROCESSED + 1))
    fi
done

# Log completion
echo "$(date '+%Y-%m-%d %H:%M:%S') - Processed $PROCESSED files" >> "$LOG_FILE"

# Create summary file
{
    echo "SDR Loopback Test Results"
    echo "========================="
    echo "Run ID: $RUNID"
    echo "Mode: AD9361 internal loopback (TX -> RX)"
    echo "Modulation: FM (5 kHz deviation)"
    echo "Frequency: 1.2 GHz"
    echo "Files processed: $PROCESSED"
    echo ""
    echo "Output files:"
    ls -la "$RUN_DIR"/*.wav 2>/dev/null || echo "  (none)"
} > "${RUN_DIR}/summary.txt"

exit 0
