#!/bin/sh

# Sherpa-ONNX Speech-to-Text - OPS-SAT SEPP Entrypoint
#
# This script transcribes WAV audio files to text using sherpa-stt
# (sherpa-onnx C API with zipformer-small model, int8 quantized, ~28 MB)
#
# Directory structure:
#   input/          - Input WAV files
#   model/          - Sherpa-ONNX model files
#   toGround/       - Output artifacts for downlink

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Directories
INPUT_DIR="${SCRIPT_DIR}/input"
MODEL_DIR="${SCRIPT_DIR}/model"
TOGROUND_DIR="${SCRIPT_DIR}/toGround"

# Locate binary: check SEPP layout first, then Docker dev layout
if [ -x "${SCRIPT_DIR}/sherpa-stt" ]; then
    SHERPA_STT="${SCRIPT_DIR}/sherpa-stt"
elif [ -x "${SCRIPT_DIR}/build/sherpa-stt" ]; then
    SHERPA_STT="${SCRIPT_DIR}/build/sherpa-stt"
else
    echo "Error: sherpa-stt binary not found" >&2
    exit 1
fi

# Create toGround directory if it doesn't exist
mkdir -p "$TOGROUND_DIR"

# Auto-increment run ID based on existing runs
LAST_RUN=$(ls -d "$TOGROUND_DIR"/run-* 2>/dev/null | sort -V | tail -1 | grep -o '[0-9]\{6\}$')
if [ -z "$LAST_RUN" ]; then
    RUNID=1
else
    RUNID=$((10#$LAST_RUN + 1))
fi

RUN_DIR=$(printf "%s/run-%06d" "$TOGROUND_DIR" "$RUNID")
mkdir -p "$RUN_DIR"

echo "Run $(printf '%06d' "$RUNID")"

# Check for input files
INPUT_COUNT=$(ls -1 "$INPUT_DIR"/*.wav 2>/dev/null | wc -l)
if [ "$INPUT_COUNT" -eq 0 ]; then
    echo "Error: no .wav files found in $INPUT_DIR" >&2
    exit 1
fi

# Process all WAV files in input directory
for INPUT_FILE in "$INPUT_DIR"/*.wav; do
    if [ -f "$INPUT_FILE" ]; then
        echo "  Processing: $(basename "$INPUT_FILE")"
        ${SHERPA_STT} \
            -i "$INPUT_FILE" \
            -m "$MODEL_DIR" \
            -o "$RUN_DIR"
    fi
done

echo "Output: $RUN_DIR"
exit 0
